# Server / Edge Function secrets — Dashboard → Edge Functions → Secrets (NOT Expo)
# Google Gemini. See docs/17_DECISIONS.md and docs/14_SETUP_AND_SOURCE_LOG.md
# GOOGLE_API_KEY=
# AI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
# AI_CHAT_MODEL=gemini-3.8-flash
# RESEND_API_KEY=
# EXPO_ACCESS_TOKEN=
# APP_BASE_URL=
# CRON_SECRET=   # required for dispatch-reminders (header x-cron-secret)

# Never prefix secrets with EXPO_PUBLIC_. Do not commit a filled .env.
