{
  "expo": {
    "name": "Saydo",
    "slug": "voice-to-work",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "voicetowork",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Saydo to record voice notes.",
        "NSSpeechRecognitionUsageDescription": "Allow Saydo to show your words live while you speak."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#dfff5a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.fanggore.voicetowork"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Saydo to record voice notes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#f6f4ef"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Saydo to record voice notes.",
          "speechRecognitionPermission": "Allow Saydo to show your words live while you speak."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
