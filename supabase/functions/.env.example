# Edge Function secrets — copy to supabase/functions/.env for local serve
# Hosted: Dashboard → Edge Functions → Secrets (or CLI secrets set)
# Never commit real values. Never use EXPO_PUBLIC_* for these.

# OpenAI secret key (official OpenAI)
OPENAI_API_KEY=

# Official OpenAI API base
OPENAI_BASE_URL=https://api.openai.com/v1

# Models (cheap testing defaults)
AI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AI_CHAT_MODEL=gpt-4o-mini

# Phase 6 — reminder dispatch (cron caller must send this header)
CRON_SECRET=

# Optional: Expo Push API access token (for DeviceNotRegistered handling upgrades)
# EXPO_ACCESS_TOKEN=

# Optional Phase 6 email channel
# RESEND_API_KEY=
# RESEND_FROM=
