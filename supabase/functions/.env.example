# Edge Function secrets — copy to supabase/functions/.env for local serve
# Hosted: Dashboard → Edge Functions → Secrets (or CLI secrets set)

# Naga API key (OpenAI SDK apiKey field). Never commit real values.
OPENAI_API_KEY=

# OpenAI-compatible base URL (Naga prototype default)
OPENAI_BASE_URL=https://api.naga.ac/v1

# Models (Naga catalog ids). :free = training may apply + shared rate limits.
AI_TRANSCRIPTION_MODEL=whisper-large-v3:free
AI_CHAT_MODEL=llama-4-scout-17b-16e-instruct:free
